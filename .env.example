# Zkopíruj jako .env a spouštěj: node --env-file=.env server.js
PORT=3000
HOST=0.0.0.0
SITE_NAME=ElektroHelper

# Databáze a nahrané soubory (výchozí: data/)
# DB_PATH=/var/lib/elektrohelper/elektrohelper.db
# UPLOADS_DIR=/var/lib/elektrohelper/uploads

# Cesta k Obsidian vaultu – v administraci pak jde import přímo z něj
# OBSIDIAN_VAULT=/home/uzivatel/Obsidian

# Správce vytvořený při prvním spuštění (jinak /admin/setup v prohlížeči)
# ADMIN_USER=admin
# ADMIN_PASSWORD=zmen-me-na-dlouhe-heslo

# Za reverzní proxy / Cloudflare Tunnel: loopback = proxy na stejném stroji, číslo = počet proxy
# TRUST_PROXY=loopback
# Secure cookie se přes HTTPS nastaví samo; SECURE_COOKIES=1 ho vynutí vždy
# SECURE_COOKIES=1
